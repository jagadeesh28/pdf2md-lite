{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "pdfmd-lite",
  "version": "0.7.1",
  "identifier": "com.pdfmdlite.app",
  "build": {
    "beforeBuildCommand": "cd ../../ui && npm.cmd run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pdfmd-lite — Offline PDF to Markdown",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
